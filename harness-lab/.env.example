# Copy to .env and enter credentials locally. Never commit .env.
# Native Anthropic for your current live tests:
PROVIDER=anthropic
MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Organization deployment: set PROVIDER=openai-compatible, then configure:
# MODEL=your-internal-model-id
# OPENAI_BASE_URL=https://your-model-gateway.example/v1
# OPENAI_API_KEY=
# Optional exact URL if your gateway does not use /v1/chat/completions:
# CHAT_COMPLETIONS_URL=https://your-model-gateway.example/chat/completions
# AUTH_HEADER=Authorization
# AUTH_PREFIX=Bearer
# MAX_TOKENS_FIELD=max_tokens
# SSL_CERT_FILE=C:/path/to/company-ca.pem

PORT=8765
MAX_MODEL_CALLS=10
MAX_OUTPUT_TOKENS=1800
REQUEST_TIMEOUT=90
