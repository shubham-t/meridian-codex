# Organization laptop template. Copy to .env and enter credentials locally.
# This template routes ALL model calls through the internal Chat Completions adapter.
PROVIDER=openai-compatible
MODEL=your-internal-model-id
OPENAI_BASE_URL=https://your-model-gateway.example/v1
OPENAI_API_KEY=

# Set the full URL below instead if your gateway has a custom route.
# CHAT_COMPLETIONS_URL=https://your-model-gateway.example/v1/chat/completions
AUTH_HEADER=Authorization
AUTH_PREFIX=Bearer
# For a raw key header: AUTH_HEADER=api-key and AUTH_PREFIX=
MAX_TOKENS_FIELD=max_tokens
# Use max_completion_tokens if required, or leave the value empty to omit it.
# SSL_CERT_FILE=C:/approved/path/company-ca.pem

PORT=8765
MAX_MODEL_CALLS=10
MAX_OUTPUT_TOKENS=1800
REQUEST_TIMEOUT=90
